# BookRAG AI - Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env (or copy on Windows)
# NOTE: Never commit real .env files containing sensitive values to version control.

# Application Information
APP_NAME="BookRAG AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Routing
API_V1_PREFIX="/api/v1"

# Server Network Settings
HOST="127.0.0.1"
PORT=8000

# Text Chunking Defaults (Phase 2)
CHUNKING_TARGET_SIZE=1200
CHUNKING_MAX_SIZE=1600
CHUNKING_OVERLAP=200

# Semantic Embeddings (Phase 3)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE="auto"

# Vector Retrieval (Phase 4)
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=100
INDEX_STORAGE_DIR="data/indexes"

# Cross-Encoder Reranking (Phase 6)
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=32
RERANKER_DEVICE="auto"
RERANKER_ENABLED=true
RETRIEVAL_CANDIDATE_K=20

# Extractive Question Answering (Phase 7)
QA_MODEL_NAME="deepset/roberta-base-squad2"
QA_MAX_LENGTH=512
QA_DOC_STRIDE=128
QA_MAX_ANSWER_LENGTH=64
QA_TOP_K_EVIDENCE=5
QA_N_BEST_SIZE=20
QA_ENABLED=true
QA_DEVICE="auto"
QA_NO_ANSWER_THRESHOLD=0.0

# Abstractive Question Answering / Generation (Phase 8)
GENERATION_MODEL_NAME="google/flan-t5-base"
GENERATION_MAX_INPUT_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=128
GENERATION_NUM_BEAMS=4
GENERATION_DO_SAMPLE=false
GENERATION_TEMPERATURE=1.0
GENERATION_TOP_K_EVIDENCE=5
GENERATION_ENABLED=true
GENERATION_DEVICE="auto"





