# BookRAG AI - Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env (or copy on Windows)
# NOTE: Never commit real .env files containing sensitive values to version control.

# Application Information
APP_NAME="BookRAG AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Routing
API_V1_PREFIX="/api/v1"

# Server Network Settings
HOST="127.0.0.1"
PORT=8000

# Text Chunking Defaults (Phase 2)
CHUNKING_TARGET_SIZE=1200
CHUNKING_MAX_SIZE=1600
CHUNKING_OVERLAP=200

# Semantic Embeddings (Phase 3)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE="auto"


